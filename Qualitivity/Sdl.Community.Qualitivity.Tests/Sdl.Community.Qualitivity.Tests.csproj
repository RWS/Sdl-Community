<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<SignAssembly>false</SignAssembly>
		<!-- Directory.Build.props turns it off; needed for the TradosFolder AssemblyMetadata below -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="NSubstitute" Version="4.4.0" />
		<!-- Studio ships 4.6.3 (assembly 4.2.4.0); NSubstitute pulls 4.3.0 (assembly 4.1.0.0), which lacks ValueTaskAwaiter needed by the in-memory TM -->
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
		<PackageReference Include="xunit" Version="2.6.6" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Windows.Forms" />
		<Reference Include="WindowsBase" />
		<Reference Include="DocumentFormat.OpenXml">
			<HintPath>$(TradosFolder)\DocumentFormat.OpenXml.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Desktop.IntegrationApi">
			<HintPath>$(TradosFolder)\Sdl.Desktop.IntegrationApi.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Desktop.IntegrationApi.Extensions">
			<HintPath>$(TradosFolder)\Sdl.Desktop.IntegrationApi.Extensions.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.FileTypeSupport.Framework.Core.Utilities">
			<HintPath>$(TradosFolder)\Sdl.FileTypeSupport.Framework.Core.Utilities.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.FileTypeSupport.Framework.Core">
			<HintPath>$(TradosFolder)\Sdl.FileTypeSupport.Framework.Core.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Core.Globalization">
			<HintPath>$(TradosFolder)\Sdl.Core.Globalization.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Core.Globalization.Async">
			<HintPath>$(TradosFolder)\Sdl.Core.Globalization.Async.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.LanguagePlatform.Core">
			<HintPath>$(TradosFolder)\Sdl.LanguagePlatform.Core.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.LanguagePlatform.TranslationMemory">
			<HintPath>$(TradosFolder)\Sdl.LanguagePlatform.TranslationMemory.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.ProjectAutomation.Core">
			<HintPath>$(TradosFolder)\Sdl.ProjectAutomation.Core.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.ProjectAutomation.FileBased">
			<HintPath>$(TradosFolder)\Sdl.ProjectAutomation.FileBased.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.TranslationStudioAutomation.IntegrationApi">
			<HintPath>$(TradosFolder)\Sdl.TranslationStudioAutomation.IntegrationApi.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Desktop.Platform">
			<HintPath>$(TradosFolder)\Sdl.Desktop.Platform.dll</HintPath>
		</Reference>
		<Reference Include="Sdl.Core.Settings">
			<HintPath>$(TradosFolder)\Sdl.Core.Settings.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- StudioAssemblyResolver loads Studio's own dependencies (ICU, Newtonsoft, ...) from here, with Studio's versions -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>TradosFolder</_Parameter1>
			<_Parameter2>$(TradosFolder)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- Native DLLs Studio has beside SDLTradosStudio.exe: ICU for word breaking (ja, zh), SQLite.Interop for the in-memory TM -->
	<ItemGroup>
		<None Include="$(TradosFolder)\icudt59.dll;$(TradosFolder)\icuin59.dll;$(TradosFolder)\icuuc59.dll;$(TradosFolder)\SQLite.Interop.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Sdl.Community.Qualitivity\Sdl.Community.Qualitivity.csproj" />
	</ItemGroup>

	<!-- ApplicationPaths needs Qualitivity.dll next to the loaded assemblies, so xUnit must not shadow-copy them. Generated because the repo ignores *.json. -->
	<Target Name="WriteXunitRunnerConfig" AfterTargets="Build">
		<WriteLinesToFile File="$(OutDir)xunit.runner.json" Lines="{ &quot;shadowCopy&quot;: false }" Overwrite="true" />
	</Target>

</Project>