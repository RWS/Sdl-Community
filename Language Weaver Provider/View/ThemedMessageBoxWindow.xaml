<Window x:Class="LanguageWeaverProvider.View.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="620"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="{DynamicResource Rws.Bg.Main}"
        Foreground="{DynamicResource Rws.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Sdl.Desktop.Platform.Styles;component/ButtonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="TxtMessage"
                   Margin="20,20,20,16"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   LineHeight="18"/>

        <Border Grid.Row="1"
                Background="{DynamicResource Rws.Bg.Top}"
                BorderBrush="{DynamicResource Generic.InnerBorderColor}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,12">
                <Button x:Name="BtnYes" Content="Yes" Width="80" Height="26" Margin="8,0,0,0"
                        Style="{DynamicResource Sdl.Button.PrimaryStyle}"
                        Click="BtnYes_Click" Visibility="Collapsed"/>

                <Button x:Name="BtnOk" Content="OK" Width="80" Height="26" Margin="8,0,0,0"
                        Style="{DynamicResource Sdl.Button.PrimaryStyle}"
                        Click="BtnOk_Click" Visibility="Collapsed"/>

                <Button x:Name="BtnNo" Content="No" Width="80" Height="26" Margin="8,0,0,0"
                        Style="{DynamicResource Sdl.Button.SecondaryStyle}"
                        Click="BtnNo_Click" Visibility="Collapsed"/>

                <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="26" Margin="8,0,0,0"
                        Style="{DynamicResource Sdl.Button.SecondaryStyle}"
                        Click="BtnCancel_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
